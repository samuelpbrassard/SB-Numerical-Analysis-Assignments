def fpi(x):
    counter = 0
    tol = 0.00000001
    xVals = [0]
    yVals = [x]

    while True:
        remember = x
        x = 0.5 * (x + 9/x)
        counter += 1

        xVals = xVals + [counter]
        yVals = yVals + [x]

        if abs(x - remember) < tol:
            break

        if counter > 5000:
            break
    plt.plot(xVals,yVals)
    plt.show()
    
    return x

