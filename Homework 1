def bisect(f, a, b, tol): 
    if f(a) * f(b) >= 0: 
        raise ValueError("f(a)f(b)<0 not satisfied!") 

    fa = f(a) 
    fb = f(b) 
    k = 0

    while (b - a) / 2 > tol: 
        c = (a + b) / 2 
        fc = f(c) 
        if fc == 0: 
            break 
        if fc * fa < 0:
            b = c
            fb = fc
        else:
            a = c
            fa = fc 

    xc = (a + b) / 2 
    return xc

def f(P, r):
    return ((12 * P) / r) * ((1 + r / 12)**300 - 1) - 1000000

for P in range(500, 1000, 50):
